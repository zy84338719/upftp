{
  "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
  "_comment": "Scoop bucket manifest 参考模板。实际由 goreleaser 根据 .goreleaser.yml 的 scoops 配置自动生成并推送到 github.com/zy84338719/scoop-bucket。用户安装:scoop bucket add zy84338719 https://github.com/zy84338719/scoop-bucket; scoop install upftp",
  "version": "1.0.0",
  "description": "快速、即开即用的 FTP 文件分享工具",
  "homepage": "https://github.com/zy84338719/upftp",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/zy84338719/upftp/releases/download/v1.0.0/upftp_1.0.0_windows_amd64.zip",
      "hash": "REPLACED_BY_GORELEASER"
    },
    "arm64": {
      "url": "https://github.com/zy84338719/upftp/releases/download/v1.0.0/upftp_1.0.0_windows_arm64.zip",
      "hash": "REPLACED_BY_GORELEASER"
    }
  },
  "bin": "upftp.exe",
  "checkver": {
    "url": "https://github.com/zy84338719/upftp/releases/latest",
    "regex": "tag/v([\\d.]+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/zy84338719/upftp/releases/download/v$version/upftp_$version_windows_amd64.zip"
      },
      "arm64": {
        "url": "https://github.com/zy84338719/upftp/releases/download/v$version/upftp_$version_windows_arm64.zip"
      }
    }
  }
}
